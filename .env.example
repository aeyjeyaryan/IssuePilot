# GitHub
GITHUB_TOKEN=
GITHUB_USER=
GITHUB_FORK_REMOTE=

# Ollama (local models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT=120
LLM_TEMPERATURE=0.1

# Storage
CHROMA_PATH=./.issuepilot/chroma
FAISS_PATH=./.issuepilot/faiss.index
RETRIEVER_BACKEND=chroma
RETRIEVAL_TOP_K=5

# Sandbox
SANDBOX_IMAGE=issuepilot-sandbox:latest
SANDBOX_TIMEOUT=120
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1
SANDBOX_TEST_COMMAND=python -m pytest -v -p no:cacheprovider

# Agent
MAX_ATTEMPTS=3
FORMAT_RETRIES=2
WORK_DIR=./.issuepilot/runs
DEMO_ROOT=./demo
LOG_LEVEL=INFO
